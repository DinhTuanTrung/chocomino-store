# ==============================================================================
# CHOCOMINO ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Connection (PostgreSQL, Storage, Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. SePay Payment Integration (VietQR + Techcombank Personal Account)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
SEPAY_ACCOUNT_NUMBER=your-techcombank-account-number
SEPAY_BANK_NAME=Techcombank
SEPAY_ACCOUNT_HOLDER="NGUYEN VAN TRUNG"

# 3. Telegram Bot Notifications (Shop Private Group)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-shop-group-chat-id

# 4. Email Service (Optional for MVP: Resend / Gmail SMTP)
RESEND_API_KEY=
EMAIL_FROM=shop@chocomino.local

# 5. Security & Background Crons
CRON_SECRET=generate-random-secret-for-cron-jobs

# 6. General Shop Public Metadata
NEXT_PUBLIC_SHOP_NAME=chocomino
NEXT_PUBLIC_SHOP_PHONE=0900000000
NEXT_PUBLIC_SHOP_ADDRESS="Đ. Số 2/38/32 Bình Đường 1, Khu Phố, Dĩ An, Hồ Chí Minh, Việt Nam"
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 7. Admin Authentication Credentials
ADMIN_EMAIL=admin@chocomino.local
ADMIN_PASSWORD=Chocomino2026!
